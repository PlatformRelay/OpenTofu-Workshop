# versions.env — THE toolchain pin file (US-P-PINS).
#
# Every reproducibility-critical workshop toolchain version lives here and
# nowhere else. Plain KEY=value lines only: no spaces around `=`, no quoting,
# no shell expansion. Sourced by Taskfile (dotenv), docker compose
# (--env-file), setup/terratest/Dockerfile (build args), setup/bootstrap.sh,
# and verified by scripts/verify.sh (including .github/workflows/ci.yml literals).
#
# Bump deliberately (reviewable diff); never drift via :latest.

# OpenTofu CLI — container lane + CI/setup-opentofu references in lab fixtures.
# Source: https://github.com/opentofu/opentofu/releases/tag/v1.10.3
# This PIN is what CI and the container lane run. It satisfies the workshop
# FLOOR (>= 1.9 — bootstrap MIN_TOFU / verify.sh TOFU_FLOOR, US-D-VERSION-FLOOR)
# and Lab 04's optional S3 stretch (use_lockfile, >= 1.10). Spoilers state the
# version that actually captured them, which may be newer than this pin.
TOFU_VERSION=1.10.3

# Go toolchain — Terratest container (host lane uses MIN_GO in bootstrap.sh).
# Source: https://go.dev/dl/ (go1.23.6)
GO_VERSION=1.23.6

# LocalStack community image — docker-compose and CI verify-integration service.
# Source: https://github.com/localstack/localstack (4.9.2 — last community
# release that boots without LOCALSTACK_AUTH_TOKEN).
LOCALSTACK_VERSION=4.9.2

# Terramate CLI — Day-3 lab spoilers and workflow fixtures.
# Source: https://github.com/terramate-io/terramate/releases (v0.17.1)
TERRAMATE_VERSION=0.17.1
